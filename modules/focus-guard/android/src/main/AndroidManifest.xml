<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- v1.1.2: the accessibility service runs in the foreground state with a
       persistent notification, so Android does not kill the guard process
       after the app is backgrounded. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>

    <!-- Keyword guard: reads screen text and leaves the app when a keyword or
         blocked domain appears. -->
    <service
      android:name="com.focusblocker.guard.FocusAccessibilityService"
      android:exported="true"
      android:label="@string/focus_guard_service_label"
      android:foregroundServiceType="specialUse"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Keeps the keyword and domain guard running while the screen is used" />
    </service>

    <!-- Device admin: while active, Android refuses to uninstall this app. -->
    <receiver
      android:name="com.focusblocker.guard.FocusDeviceAdminReceiver"
      android:exported="true"
      android:label="@string/device_admin_label"
      android:description="@string/device_admin_description"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>

  </application>

</manifest>
