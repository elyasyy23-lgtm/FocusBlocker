<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- v1.1.2: the accessibility service runs in the foreground state with a
       persistent notification, so Android does not kill the guard process
       after the app is backgrounded. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- v1.1.3: lets the app show the system dialog that excludes it from
       battery optimization — the standard fix for OEM battery managers
       that kill the foreground service after ~a day. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- v1.1.4: the boot receiver restarts the keep-alive watchdog after a
       reboot (alarms and the app process are gone at that point), and the
       persisted JobScheduler job needs it too. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- v1.4.0: remote deactivation via SMS. Requested at runtime when the owner
       switches the feature on; without the grant the receiver never fires. -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />

  <!-- v1.1.4: Android 11+ package visibility. resolveActivity() only sees
       packages listed here, and the "Open Autostart settings" deep link is
       resolved before it is used — without these entries it would always fall
       back to the app-details page. Vendor autostart screens have no public API;
       these are the known ones. -->
  <queries>
    <!-- v1.2.0: the Excluded Apps picker lists every app with a launcher icon.
         Without this intent entry queryIntentActivities() returns only our own
         package on Android 11+. -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <package android:name="com.miui.securitycenter" />
    <package android:name="com.huawei.systemmanager" />
    <package android:name="com.coloros.safecenter" />
    <package android:name="com.oppo.safe" />
    <package android:name="com.vivo.permissionmanager" />
    <package android:name="com.iqoo.secure" />
    <package android:name="com.samsung.android.lool" />
    <package android:name="com.asus.mobilemanager" />
  </queries>

  <application>

    <!-- Keyword guard: reads screen text and leaves the app when a keyword or
         blocked domain appears. -->
    <service
      android:name="com.focusblocker.guard.FocusAccessibilityService"
      android:exported="true"
      android:label="@string/focus_guard_service_label"
      android:foregroundServiceType="specialUse"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Keeps the keyword and domain guard running while the screen is used" />
    </service>

    <!-- Device admin: while active, Android refuses to uninstall this app. -->
    <receiver
      android:name="com.focusblocker.guard.FocusDeviceAdminReceiver"
      android:exported="true"
      android:label="@string/device_admin_label"
      android:description="@string/device_admin_description"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>

    <!-- v1.1.4 keep-alive (layer 1): a normal started service, so Android can
         restart it by itself (START_STICKY) and it can be started on demand
         from an alarm, a job or the boot receiver. It owns the persistent
         notification and brings the app process back up, which is what lets
         the system rebind the accessibility service. -->
    <service
      android:name="com.focusblocker.guard.GuardWatchdogService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Restarts the keyword and domain guard after Android kills the app process" />
    </service>

    <!-- v1.1.4 keep-alive (layer 2): system broadcast door — boot, app update
         and the repeating 15-minute alarm. Works while the app is dead. -->
    <receiver
      android:name="com.focusblocker.guard.GuardWakeupReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.focusblocker.guard.WAKEUP" />
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- v1.4.0 remote deactivation: the partner's SMS turns Protection off.
         BROADCAST_SMS as the receiver permission means only the system (which
         holds it) can trigger us. The receiver itself returns immediately
         while the feature is switched off in Settings. -->
    <receiver
      android:name="com.focusblocker.guard.RemoteSmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>

    <!-- v1.1.4 keep-alive (layer 3): persisted periodic job, survives reboots
         without any of our code running. -->
    <service
      android:name="com.focusblocker.guard.GuardJobService"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />

  </application>

</manifest>
